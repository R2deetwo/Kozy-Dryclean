# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Allow .env.example to be committed (it has no real secrets, just placeholders)
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Local SQLite DB (we use Supabase now)
/db/
*.db

# Stale env file from earlier migration
.env.old

# Downloaded screenshots (regenerable)
download/*.png

# Sandbox upload staging area (mounted by Z.ai sandbox, not tracked)
upload/
package-lock.json
.vercel
.env.dbpush

# Recovered session DB credential stashes (never commit)
scripts/.dburl
scripts/.directurl
scripts/.pgenv
# Owner-provided deployment tokens (never commit)
.secrets/

# Task 90 hygiene: secrets, prod data and dev environments never enter git
work/backups/
work/*.env
work/env.backup*
work/.prod_*
work/.t80_woosh*
work/*cron_secret*
work/token_check*.json
work/*token_probe*.json
work/*dpl_files*.json
work/*headers*.txt
work/pgvenv/
work/*inboxes*.json
work/*vapid*
work/vercel-envs*
work/.t80_verify_links.json
work/.t81_live_member.json
work/.t80_test_email
work/.t76_emails_sent
work/.s.PGSQL.*
# VAPID key-bearing one-shot deploy helpers (keys must never be public)
scripts/p61_deploy_when_token.sh
scripts/p61_push_format_probe.js

# vercel CLI local linking
.vercel/

# Local embedded-postgres data (phase 36 dev DB) — never commit
work/pgdata-tcp/
work/pg-tcp.log
work/initdb.log
work/.s.PGSQL.*.lock
# Phase 61 QA: local-only artifacts (throwaway TLS certs, browser profile, PG data)
work/p61-chrome-profile*/
work/pgembed/
work/pgdata/
work/pg.log
work/p61-push-mock.*
research/
tool-results/
