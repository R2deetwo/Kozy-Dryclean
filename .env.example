# ============================================================================
# Kozy Drycleaning and Laundry Services — Environment Variables
# ============================================================================
# Copy this file to `.env.local` for development and to `.env` for production.
# In Vercel, set these in: Project Settings → Environment Variables.
# NEVER commit your real `.env.local` file. The `.gitignore` already excludes it.
# ============================================================================

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production: https://your-domain.com or https://kozy-dryclean.vercel.app

# Brand contact info shown in UI
NEXT_PUBLIC_COMPANY_PHONE=+2348005693789
NEXT_PUBLIC_COMPANY_EMAIL=concierge@kozy.ng

# ---------------------------------------------------------------------------
# DATABASE (Supabase — see deployment guide)
# ---------------------------------------------------------------------------
# Pooler URL (transaction mode, port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct URL (session mode, port 5432) — used by Prisma for migrations
DIRECT_URL="postgresql://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# AUTH (NextAuth.js v4)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL (must match NEXT_PUBLIC_APP_URL in production)
NEXTAUTH_URL=http://localhost:3000

# Optional: Google OAuth for social sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth (for admin/dev login)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# PAYMENTS (Paystack)
# ---------------------------------------------------------------------------
# Get from: https://dashboard.paystack.com/settings/developer/api-keys
# Test keys start with sk_test_ / pk_test_
# Live keys start with sk_live_ / pk_live_
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used to verify webhook signatures — same as PAYSTACK_SECRET_KEY for the basic check
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Paystack business ID (optional, for some endpoints)
PAYSTACK_BUSINESS_ID=

# ---------------------------------------------------------------------------
# SMS & WHATSAPP (Termii)
# ---------------------------------------------------------------------------
# Get from: https://termii.com/account
TERMII_API_KEY=
# Sender ID must be pre-approved by Termii (e.g. "Kozy" or "KOZYNG")
TERMII_SENDER_ID=Kozy
# Channel: dnd, generic, whatsapp, etc.
TERMII_CHANNEL=generic
# Optional: WhatsApp template ID (must be pre-approved)
TERMII_WA_TEMPLATE_ID=

# Optional: Twilio as backup SMS provider
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# EMAIL (Postmark)
# ---------------------------------------------------------------------------
# Get from: https://account.postmarkapp.com
POSTMARK_API_KEY=
# Verified sender email — must match a verified sender signature in Postmark
POSTMARK_SENDER_EMAIL=concierge@kozy.ng
# Optional: separate stream for transactional vs marketing
POSTMARK_STREAM=outbound

# ---------------------------------------------------------------------------
# FILE STORAGE (Cloudflare R2 — S3-compatible)
# ---------------------------------------------------------------------------
# Create a bucket at: https://dash.cloudflare.com → R2 → Create bucket
# Then create an API token under R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kozy-uploads
# Public URL prefix (set up a Cloudflare worker or custom domain)
R2_PUBLIC_URL=https://uploads.kozy.ng
# Region (leave empty for auto)
R2_REGION=auto

# Optional: AWS S3 instead of R2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=kozy-uploads
# AWS_REGION=af-west-1

# ---------------------------------------------------------------------------
# ERROR MONITORING (Sentry — optional but recommended)
# ---------------------------------------------------------------------------
# Get from: https://sentry.io/settings/[org]/projects/[project]/keys/
SENTRY_DSN=
# Optional: auth token for source map uploads
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# MAPS (optional, for driver navigation)
# ---------------------------------------------------------------------------
# Google Maps Platform — enable "Maps JavaScript API" + "Distance Matrix API"
GOOGLE_MAPS_API_KEY=
# OR Mapbox
MAPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# VERCEL (only needed if using Vercel CLI for deploys)
# ---------------------------------------------------------------------------
# Generate at: https://vercel.com/account/tokens
VERCEL_TOKEN=
# Found in project settings after `vercel link`
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ---------------------------------------------------------------------------
# GITHUB (only needed for CI/CD or scripted deploys)
# ---------------------------------------------------------------------------
# Create at: https://github.com/settings/tokens (classic) or fine-grained
# Scopes needed: repo, workflow (if using GitHub Actions)
GH_PAT=
