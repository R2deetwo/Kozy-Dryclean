// Kozy Drycleaning and Laundry Services - Database Schema
// Implements the relational structure described in the master prompt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// USERS — authentication & RBAC
// =====================================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String
  address       String?
  role          Role     @default(B2C)
  company       String?
  // Auth fields
  passwordHash  String?
  emailVerified DateTime?
  // Staff-access lifecycle (phase 31): 'ACTIVE' | 'PAUSED' | 'REVOKED'.
  // Soft state — pausing or revoking a staff member never destroys their
  // audit trail (StatusEvent actor links, payment verifier trail). Only
  // console roles (ADMIN/STAFF/DRIVER) are policed against this field; a
  // customer's value is ignored. Enforced at login (authorize rejects) and
  // on every console API call via the cached live check in src/lib/auth.ts.
  accessStatus  String   @default("ACTIVE")
  // Discount tracking
  signupDiscountUsed Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders             Order[]
  payments           Payment[]
  drivenOrders       Order[]             @relation("DriverOrders")
  verificationTokens VerificationToken[]
  statusEvents       StatusEvent[]
  // Reviews authored by this user (as customer)
  reviews            Review[]
  // Reviews this user has approved (as admin)
  approvedReviews    Review[]            @relation("ReviewApprover")
  // Last known GPS position (rider geofencing) — one row per driver
  driverLocation     DriverLocation?
}

enum Role {
  ADMIN
  // Phase 31: back-office staff (invited by a super admin). Signs into the
  // SAME Atelier Console as admins, restricted to the operational side
  // (orders, payment verification, customers, notifications, feedback) —
  // never pricing, the discount engine, finances, reviews or staff admin.
  // Only admins can create/pause/revoke STAFF accounts (see /api/staff).
  STAFF
  DRIVER
  B2C
  B2B
}

// =====================================================
// ORDERS — central hub for laundry batch lifecycle
// =====================================================
model Order {
  id                String         @id @default(cuid())
  // Human-readable ID like #KZ-1024
  orderNumber       String         @unique
  userId            String
  driverId          String?
  user              User           @relation(fields: [userId], references: [id])
  driver            User?          @relation("DriverOrders", fields: [driverId], references: [id])
  status            OrderStatus    @default(REQUESTED)
  type              OrderType
  // For B2B: weight (kg) entered by admin
  finalWeight       Float?
  // Computed total in naira
  totalPrice        Float?
  // B2C condition-capture guarantee
  guaranteeActive   Boolean        @default(false)
  // Turnaround tier: STANDARD (3–5 days) / EXPRESS_48 / EXPRESS_24.
  // Express surcharge is baked into totalPrice at creation time.
  serviceSpeed      String         @default("STANDARD")
  // Mode of wash chosen by the customer (retail orders): HANDWASH carries a
  // per-item surcharge, MACHINE is standard. Null for KG/corporate orders.
  modeOfWash        String?
  // Offer code redeemed at checkout (e.g. HOTEL15 for hotel guests).
  // Null when no code was used.
  promoCode         String?
  // Delivery fee charged on this order (naira). 0 when the order qualified
  // for the free first delivery; the going rate for subsequent deliveries
  // is admin-configurable in AppSetting (delivery_fee).
  deliveryFee       Float?  @default(0)
  // Per-item manifest snapshot for B2C, JSON-stringified
  itemsManifest     String?
  // Alterations (Phase 17): the customer's description of the alteration
  // work, captured at booking ("navy trousers — take the waist in 2 inches").
  // Required whenever the manifest contains an alterations item — the
  // seamstress works from this note; riders never measure at the door.
  alterationNotes   String?
  // Logistics
  pickupAddress     String
  pickupDate        DateTime
  pickupTimeSlot    String
  deliveryAddress   String?
  deliveryDate      DateTime?
  // Audit timestamps for the pipeline
  pickedUpAt        DateTime?
  atStationAt       DateTime?
  processingAt      DateTime?
  finishingAt       DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  // ----- Stage-email dedup (phase 24, client request) -----
  // Highest PIPELINE_STAGES index the customer has ALREADY been emailed
  // about (the booking-confirmation email counts as stage 0 "Requested").
  // A status email is sent ONLY when the new stage index is strictly
  // greater than this value — so dragging a Kanban card backwards and
  // forwards again can never re-send an earlier stage's email, and no
  // customer ever receives an email implying their items went backwards.
  lastNotifiedStage Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  media             GarmentMedia[]
  payments          Payment[]
  statusEvents      StatusEvent[]
  // Customer feedback (one-to-one — one review per order)
  review            Review?

  @@index([userId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
}

enum OrderStatus {
  REQUESTED
  PAYMENT_PENDING_VERIFICATION
  PAYMENT_VERIFIED
  PICKED_UP
  AT_STATION
  PROCESSING
  FINISHING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  ITEM
  KG
}

// =====================================================
// NOTIFICATION_EVENT — in-app operations feed for the admins
// =====================================================
// Every admin alert (new signup, new order, transfer pending, feedback,
// rider application, test send) is recorded here at the same moment the
// alert emails go out, WITH the per-recipient delivery result. This gives
// the business owner an in-app record that survives spam-folder mishaps:
// even if an email is junk-mailed, the event — and whether Brevo accepted
// the send — is visible in Admin → Notifications.
model NotificationEvent {
  id          String    @id @default(cuid())
  // NEW_SIGNUP | NEW_ORDER | TRANSFER_PENDING | FEEDBACK | RIDER_APPLICATION | TEST
  type        String
  title       String
  body        String    @db.Text
  // JSON payload for deep links / details (orderNumber, userEmail, ...)
  data        String?   @db.Text
  // Admin console link (e.g. "kanban", "payments")
  linkTab     String?
  // JSON array of alert recipients attempted
  recipients  String?   @db.Text
  // NONE | DISABLED | SENT | PARTIAL | FAILED — email delivery outcome
  emailStatus String    @default("NONE")
  // Per-recipient results + error detail, JSON
  emailDetail String?   @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt])
  @@index([type])
}

// =====================================================
// GARMENT_MEDIA — B2C condition-capture photos
// =====================================================
model GarmentMedia {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  imageUrl  String
  notes     String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// =====================================================
// PAYMENTS — manual transfer receipts + Paystack hooks
// =====================================================
model Payment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Float
  method      PaymentMethod
  status      PaymentStatus   @default(PENDING)
  // URL to uploaded receipt screenshot (manual flow)
  receiptUrl  String?
  // Paystack dedicated virtual account reference
  paystackRef String?
  verifiedAt  DateTime?
  verifiedById String?
  verifier    User?           @relation(fields: [verifiedById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([paystackRef])
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// =====================================================
// STATUS_EVENT — audit trail for the order pipeline
// =====================================================
model StatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actor      User?       @relation(fields: [actorId], references: [id])
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([actorId])
}

// =====================================================
// VERIFICATION_TOKEN — email verification flow
// =====================================================
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
}

// =====================================================
// DISCOUNT — admin-managed discounts
// =====================================================
model Discount {
  id          String   @id @default(cuid())
  name        String   // "Signup Discount", "Weekend Promo", etc.
  code        String?  @unique // optional promo code
  type        String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  value       Float    // 5 = 5% or 500 = ₦500
  active      Boolean  @default(true)
  appliesTo   String   @default("ALL") // ALL, SIGNUP, FIRST_ORDER
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================================
// RIDER_APPLICATION — driver recruitment applications
// =====================================================
model RiderApplication {
  id            String   @id @default(cuid())
  fullName      String
  email         String?
  phone         String
  altPhone      String?
  address       String
  lga           String   // preferred area
  bikeModel     String
  bikeYear      String
  licenseNumber String
  availability  String   @default("full-time")
  experience    String?
  consent      Boolean  @default(false)
  status       String   @default("PENDING") // PENDING, REVIEWED, APPROVED, REJECTED
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// =====================================================
// PRICE_CATALOG — server-side canonical pricing
// =====================================================
model PriceCatalog {
  id        String   @id @default(cuid())
  itemKey   String   @unique // matches GARMENT_CATALOG id (shirt, trouser, etc.)
  label     String
  unitPrice Float
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// =====================================================
// APP_SETTING — server-side key/value settings (admin-managed)
// =====================================================
// Bank account details, delivery fee, handwash surcharge, guarantee
// thresholds and offer percentages live HERE (not localStorage) so an
// admin edit instantly reaches every visitor — the persisted zustand
// copy was per-browser and never propagated (client-reported bug).
model AppSetting {
  key       String   @id // e.g. "bank_name", "delivery_fee"
  value     String // JSON-encoded value
  updatedAt DateTime @updatedAt
}

// =====================================================
// FEEDBACK — general reviews & complaints from the site form
// =====================================================
// Complements Review (which is tied to a delivered order): Feedback lets
// ANY visitor — including prospects and hotel partners — send a review,
// question or complaint without an order number.
model Feedback {
  id          String   @id @default(cuid())
  // REVIEW | COMPLAINT | QUESTION
  type        String   @default("REVIEW")
  name        String
  email       String
  phone       String?
  // Optional reference: an order number (KZ-…) or a hotel/estate name
  reference   String?
  rating      Float? // optional 1–5 for reviews
  message     String
  // Admin workflow: NEW → IN_PROGRESS → RESOLVED (+ admin note)
  status      String   @default("NEW")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// =====================================================
// DRIVER_LOCATION — rider geofencing (last known GPS ping)
// =====================================================
// Riders ping their GPS position from the driver app; the server
// checks the distance to the nearest service zone (see src/lib/geo.ts)
// and gates order activity/notifications accordingly:
//   - Inside a service zone   -> full route activity
//   - Outside all zones       -> order activity paused (banner in app)
//   - Stale/missing ping      -> legacy behaviour (no filtering)
model DriverLocation {
  id        String   @id @default(cuid())
  driverId  String   @unique
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  // Name of the nearest service zone at the last ping (e.g. "Lekki")
  zone      String?
  updatedAt DateTime @updatedAt

  @@index([driverId])
}

// =====================================================
// REVIEW — customer feedback on completed orders
// =====================================================
// Public display rules:
//   - Only reviews with isApproved=true AND rating >= 4.5 are shown on the
//     customer landing page testimonials carousel.
//   - All reviews (including low ratings and unapproved) are visible to admins
//     in the moderation view, so the company can still see negative feedback
//     internally and act on it (contact customer, address driver issues, etc.)
model Review {
  id          String   @id @default(cuid())
  orderId     String   @unique // one review per order
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  driverId    String?  // optional — present if user rated the driver specifically
  // 1-5 stars (allows halves: 4.5, 5.0, etc.)
  rating      Float
  comment     String
  // Public display name on the testimonials carousel (defaults to user.name
  // but admin can edit, e.g., "Tunde A., Lekki")
  displayName String?
  // Location shown next to the testimonial (e.g., "Lekki Phase 1")
  displayLocation String?
  // Moderation: only approved reviews with rating >= 4.5 show publicly
  isApproved  Boolean  @default(false)
  approvedAt  DateTime?
  approvedById String?
  approver    User?    @relation("ReviewApprover", fields: [approvedById], references: [id])
  // Soft-hide: even if approved, admin can hide without deleting
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([driverId])
  @@index([isApproved])
  @@index([rating])
}
