// Kozy Drycleaning and Laundry Services - Database Schema
// Implements the relational structure described in the master prompt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// USERS — authentication & RBAC
// =====================================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String
  address       String?
  role          Role     @default(B2C)
  company       String?
  // Auth fields
  passwordHash  String?
  emailVerified DateTime?
  // Discount tracking
  signupDiscountUsed Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders             Order[]
  payments           Payment[]
  drivenOrders       Order[]             @relation("DriverOrders")
  verificationTokens VerificationToken[]
  statusEvents       StatusEvent[]
}

enum Role {
  ADMIN
  DRIVER
  B2C
  B2B
}

// =====================================================
// ORDERS — central hub for laundry batch lifecycle
// =====================================================
model Order {
  id                String         @id @default(cuid())
  // Human-readable ID like #KZ-1024
  orderNumber       String         @unique
  userId            String
  driverId          String?
  user              User           @relation(fields: [userId], references: [id])
  driver            User?          @relation("DriverOrders", fields: [driverId], references: [id])
  status            OrderStatus    @default(REQUESTED)
  type              OrderType
  // For B2B: weight (kg) entered by admin
  finalWeight       Float?
  // Computed total in naira
  totalPrice        Float?
  // B2C condition-capture guarantee
  guaranteeActive   Boolean        @default(false)
  // Per-item manifest snapshot for B2C, JSON-stringified
  itemsManifest     String?
  // Logistics
  pickupAddress     String
  pickupDate        DateTime
  pickupTimeSlot    String
  deliveryAddress   String?
  deliveryDate      DateTime?
  // Audit timestamps for the pipeline
  pickedUpAt        DateTime?
  atStationAt       DateTime?
  processingAt      DateTime?
  finishingAt       DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  media             GarmentMedia[]
  payments          Payment[]
  statusEvents      StatusEvent[]

  @@index([userId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
}

enum OrderStatus {
  REQUESTED
  PAYMENT_PENDING_VERIFICATION
  PAYMENT_VERIFIED
  PICKED_UP
  AT_STATION
  PROCESSING
  FINISHING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  ITEM
  KG
}

// =====================================================
// GARMENT_MEDIA — B2C condition-capture photos
// =====================================================
model GarmentMedia {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  imageUrl  String
  notes     String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// =====================================================
// PAYMENTS — manual transfer receipts + Paystack hooks
// =====================================================
model Payment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Float
  method      PaymentMethod
  status      PaymentStatus   @default(PENDING)
  // URL to uploaded receipt screenshot (manual flow)
  receiptUrl  String?
  // Paystack dedicated virtual account reference
  paystackRef String?
  verifiedAt  DateTime?
  verifiedById String?
  verifier    User?           @relation(fields: [verifiedById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([paystackRef])
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// =====================================================
// STATUS_EVENT — audit trail for the order pipeline
// =====================================================
model StatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actor      User?       @relation(fields: [actorId], references: [id])
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([actorId])
}

// =====================================================
// VERIFICATION_TOKEN — email verification flow
// =====================================================
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
}

// =====================================================
// DISCOUNT — admin-managed discounts
// =====================================================
model Discount {
  id          String   @id @default(cuid())
  name        String   // "Signup Discount", "Weekend Promo", etc.
  code        String?  @unique // optional promo code
  type        String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  value       Float    // 5 = 5% or 500 = ₦500
  active      Boolean  @default(true)
  appliesTo   String   @default("ALL") // ALL, SIGNUP, FIRST_ORDER
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================================
// RIDER_APPLICATION — driver recruitment applications
// =====================================================
model RiderApplication {
  id            String   @id @default(cuid())
  fullName      String
  email         String?
  phone         String
  altPhone      String?
  address       String
  lga           String   // preferred area
  bikeModel     String
  bikeYear      String
  licenseNumber String
  availability  String   @default("full-time")
  experience    String?
  consent      Boolean  @default(false)
  status       String   @default("PENDING") // PENDING, REVIEWED, APPROVED, REJECTED
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// =====================================================
// PRICE_CATALOG — server-side canonical pricing
// =====================================================
model PriceCatalog {
  id        String   @id @default(cuid())
  itemKey   String   @unique // matches GARMENT_CATALOG id (shirt, trouser, etc.)
  label     String
  unitPrice Float
  category  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
}
